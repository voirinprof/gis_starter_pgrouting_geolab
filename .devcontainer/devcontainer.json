{
  "name": "PostGIS pgRouting Flask Devcontainer",
  "image": "mcr.microsoft.com/devcontainers/base:dev-debian",
  "workspaceFolder": "/workspaces/gis_starter_pgrouting_geolab",
  "postCreateCommand": "docker compose up -d",
  "portsAttributes": {
    "80": {
      "label": "pgRouting Web Server",
      "onAutoForward": "openPreview"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-azuretools.vscode-docker",
        "ms-python.python",
        "ms-python.vscode-pylance",
        "redhat.vscode-yaml",
        "mtxr.sqltools",
        "mtxr.sqltools-driver-pg"
      ]
    }
  }
}


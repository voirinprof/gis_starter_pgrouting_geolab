{
  "name": "PostGIS pgRouting Flask Devcontainer",
  "dockerComposeFile": "docker-compose.yml",
  "service": "flask",
  "workspaceFolder": "/workspaces/gis_starter_pgrouting_geolab",
  "forwardPorts": [80, 5432, 5050],
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.vscode-docker",
        "ms-python.python",
        "ms-python.vscode-pylance",
        "redhat.vscode-yaml",
        "mtxr.sqltools",
        "mtxr.sqltools-driver-pg"
      ]
    }
  }
}